<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11 counterpart of data_extraction_rules.xml. android:allowBackup="false" already turns
    backup off there; this excludes everything anyway in case allowBackup is ever flipped.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
