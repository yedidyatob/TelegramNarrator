    <!-- Experimental Edge TTS -->
    <string name="settings_edge_title">Edge neural voices (experimental)</string>
    <string name="settings_edge_warning">Experimental and unofficial: this uses the endpoint behind Microsoft Edge\'s \"Read aloud\" feature (the same approach as the open-source edge-tts library). It costs $0 and needs no account or key, but it is not a supported Microsoft API and may break or be blocked at any time. Needs a network connection: cleaned message text is sent to Microsoft (speech.platform.bing.com). If it fails, the app shows a short notice and reads with the system voice. Audio is cached on device.</string>
