{
  "version": 1,

  "default": {
    "rules": {},
    "options": {
      "readLinks": false,
      "removeTelegramLinks": true,
      "numberedLists": "keep"
    }
  },

  "channels": [
    {
      "name": "Abu Ali Express",
      "match": { "titleEquals": "אבו עלי אקספרס" },
      "inheritDefault": true,
      "rules": {
        "cut": [
          "^[ \\t]*(?:\\d+[ \\t]+(?:תגובות|תגובה)|תגובה[ \\t]+אחת)[ \\t]*$",
          "כדי להגיב לכתבה לחצו כאן"
        ],
        "replace": []
      },
      "options": {
        "numberedLists": "natural",
        "stripSymbols": ["°"]
      }
    }
  ]
}
